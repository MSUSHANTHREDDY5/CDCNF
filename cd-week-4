
#include <iostream>
#include <vector>
#include <string>
using namespace std;

string table[5][6] = {
    {"TR", "",    "",    "TR",  "",   ""},
    {"",   "+TR", "",    "",    "#",  "#"},
    {"FY", "",    "",    "FY",  "",   ""},
    {"",   "#",   "*FY", "",    "#",  "#"},
    {"i",  "",    "",    "(E)", "",   ""}
};

int row(char c)
{
    if (c == 'E') return 0;
    if (c == 'R') return 1;
    if (c == 'T') return 2;
    if (c == 'Y') return 3;
    if (c == 'F') return 4;
    return -1;
}

int col(char c)
{
    if (c == 'i') return 0;
    if (c == '+') return 1;
    if (c == '*') return 2;
    if (c == '(') return 3;
    if (c == ')') return 4;
    if (c == '$') return 5;
    return -1;
}

int main()
{
    string input;
    vector<char> st;

    cout << "Enter input (use i for id): ";
    cin >> input;

    input += '$';

    st.push_back('$');
    st.push_back('E');

    int i = 0;

    cout << "\nStack\t\tInput\t\tAction\n";
    cout << "---------------------------------------------\n";

    while (!st.empty())
    {
        // Display stack
        string s = "";
        for (int j = 0; j < st.size(); j++)
            s += st[j];

        char X = st.back();
        char a = input[i];

        cout << s << "\t\t" << input.substr(i) << "\t\t";

        // Accept
        if (X == '$' && a == '$')
        {
            cout << "Accept\n";
            return 0;
        }

        // Match terminal
        if (X == a)
        {
            cout << "Match " << a << "\n";
            st.pop_back();
            i++;
        }

        // Apply production
        else if (row(X) != -1)
        {
            int r = row(X);
            int c = col(a);

            if (c == -1 || table[r][c] == "")
            {
                cout << "Error\n";
                cout << "\nString Rejected\n";
                return 0;
            }

            string p = table[r][c];

            if (p == "#")
                cout << X << " -> epsilon\n";
            else
                cout << X << " -> " << p << "\n";

            st.pop_back();

            // Push production in reverse order
            if (p != "#")
            {
                for (int j = p.length() - 1; j >= 0; j--)
                    st.push_back(p[j]);
            }
        }
        else
        {
            cout << "Error\n";
            cout << "\nString Rejected\n";
            return 0;
        }
    }

    cout << "\nString Rejected\n";
    return 0;
}
